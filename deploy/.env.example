# Copy to ../.env (mode 600). Values are secrets except the last four.
AZURE_OPENAI_API_KEY=
# Optional: a different key for the navigator (e.g. LITELLM_KEY when NAVIGATOR_API_BASE is the LiteLLM gateway)
NAVIGATOR_API_KEY=
NAVIGATOR_API_BASE=https://sam-watson-codex-key-resource.services.ai.azure.com/openai/v1
NAVIGATOR_MODEL=gpt-5.6-luna   # 2026-09-26 same-grammar run: sol 90/92 % p50 3.2 s, terra 89/88 % p50 2.4 s, luna 90/91 % p50 2.2 s
NAVIGATOR_REASONING=low
HCDP_API_BASE=https://api.hcdp.ikewai.org
HCDP_API_TOKEN=
SITE_ADDRESS=hcdp-with-ai.cis251375.projects.jetstream-cloud.org
AI_INTERFACE_URL=https://hcdp-ai-interface.cis251375.projects.jetstream-cloud.org
